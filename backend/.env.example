# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The LlmClient port takes baseUrl + model + apiKey. Both providers below are
# OpenAI-wire-compatible, so switching providers is a config change, not code.
# Set LLM_PROVIDER to pick which block is used.
#
# Provider probe (2026-09-11, see DECISIONS.md #15): TensorMux times out (504
# after ~121s) on the realistic strict json_schema payload this project sends
# and does not reliably enforce strict mode when it does respond — disqualified
# as primary. OpenAI (gpt-5-nano) confirmed working with reasoning_effort:
# "minimal" + max_completion_tokens (not max_tokens) + no custom temperature.

LLM_PROVIDER=openai

# --- TensorMux (Zhipu GLM-4.7-Flash, OpenAI-compatible proxy) — kept for the
# LlmClient port's second configuration; not used as primary, see probe above ---
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_MODEL=glm-4-7-flash
TENSORMUX_API_KEY=

# --- OpenAI (stock endpoint) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano
OPENAI_API_KEY=

# Evaluation reliability policy (decision 10)
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

PORT=3000
DATABASE_PATH=./data/app.db
